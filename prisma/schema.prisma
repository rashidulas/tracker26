generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums
enum CategoryType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
  LOAN
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

// Models
model Category {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      CategoryType
  color     String
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  subcategories Subcategory[]
  transactions  Transaction[]
  budgets       Budget[]

  @@unique([name, type])
  @@index([type])
}

model Subcategory {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  categoryId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([categoryId])
  @@unique([categoryId, name])
}

model Account {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            AccountType
  institution     String?
  startingBalance Float       @default(0)
  creditLimit     Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transactionsFrom  Transaction[]      @relation("FromAccount")
  transactionsTo    Transaction[]      @relation("ToAccount")
  goalContributions GoalContribution[]
  goals             Goal[]
  friendEntries     FriendEntry[]

  @@index([type])
}

type SplitItem {
  categoryId String
  amount     Float
  notes      String?
}

type AccountSplitItem {
  accountId String
  amount    Float
}

model Transaction {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  date             DateTime
  amount           Float
  kind             TransactionKind
  categoryId       String?         @db.ObjectId
  subcategoryId    String?         @db.ObjectId
  accountId        String?         @db.ObjectId
  toAccountId      String?         @db.ObjectId
  merchantOrSource String?
  notes            String?
  tags             String[]
  splitItems       SplitItem[]
  accountSplits    AccountSplitItem[]
  splitGroupId     String?
  /// Expenses only: the part of `amount` that friends owe you (the sum of the
  /// linked FriendEntry rows). Your spending is amount - sharedAmount; the
  /// account balance still moves by the full amount. Kept by lib/transactions.
  sharedAmount     Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  category    Category?    @relation(fields: [categoryId], references: [id])
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  account     Account?     @relation("FromAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount   Account?     @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  friendEntries     FriendEntry[]
  goalContributions GoalContribution[]

  @@index([date])
  @@index([kind])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([accountId])
  @@index([toAccountId])
  @@index([splitGroupId])
  @@index([date, kind])
}

model Goal {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  targetAmount Float
  dueDate      DateTime?
  /// Optional account that holds this goal's savings. When set, contributions
  /// are real transfers into it; otherwise they are earmarks on the source.
  accountId    String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  account       Account?           @relation(fields: [accountId], references: [id])
  contributions GoalContribution[]

  @@index([accountId])
}

model GoalContribution {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  goalId        String   @db.ObjectId
  date          DateTime
  amount        Float
  fromAccountId String   @db.ObjectId
  /// The TRANSFER that moved this money into the goal's account. Null means
  /// an earmark: the money stays in fromAccount but is no longer "available".
  transactionId String?  @db.ObjectId
  notes         String?
  createdAt     DateTime @default(now())

  goal        Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  fromAccount Account      @relation(fields: [fromAccountId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([goalId])
  @@index([fromAccountId])
  @@index([transactionId])
}

model Budget {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  month      DateTime
  categoryId String   @db.ObjectId
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([month, categoryId])
  @@index([month])
  @@index([categoryId])
}

// Friends / shared IOUs
// Balance from your perspective: positive = they owe you, negative = you owe them
enum FriendEntryType {
  THEY_OWE_ME
  I_OWE_THEM
  THEY_PAID_ME
  I_PAID_THEM
}

model Friend {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  notes     String?
  color     String   @default("#7aa2f7")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries FriendEntry[]
}

model FriendEntry {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  friendId    String          @db.ObjectId
  date        DateTime
  amount      Float
  type        FriendEntryType
  description String?
  notes       String?
  /// Set when this IOU is a friend's share of one of your expenses. The
  /// expense moved the money, so an entry with a transaction has no account.
  transactionId String?       @db.ObjectId
  /// Account the money went through (lent, borrowed, received or paid back).
  /// Moves that account's balance. Never set together with transactionId.
  accountId     String?       @db.ObjectId
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  friend      Friend       @relation(fields: [friendId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account?     @relation(fields: [accountId], references: [id])

  @@index([friendId])
  @@index([date])
  @@index([friendId, date])
  @@index([transactionId])
  @@index([accountId])
}
