generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Enums
enum CategoryType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
}

enum DebtType {
  CREDIT_CARD
  STUDENT_LOAN
  MORTGAGE
  PERSONAL_LOAN
  AUTO_LOAN
  OTHER
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  CONTRIBUTION
  WITHDRAWAL
}

// Models
model Category {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      CategoryType
  color     String
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  transactions Transaction[]
  budgets      Budget[]

  @@index([type])
}

model Account {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  type            AccountType
  institution     String?
  startingBalance Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  transactionsFrom Transaction[]            @relation("FromAccount")
  transactionsTo   Transaction[]            @relation("ToAccount")
  debtPayments     DebtPayment[]
  investmentHoldings InvestmentHolding[]
  investmentTransactions InvestmentTransaction[]
  goalContributions GoalContribution[]

  @@index([type])
}

type SplitItem {
  categoryId String
  amount     Float
  notes      String?
}

model Transaction {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  date             DateTime
  amount           Float
  kind             TransactionKind
  categoryId       String?         @db.ObjectId
  accountId        String?         @db.ObjectId
  toAccountId      String?         @db.ObjectId
  merchantOrSource String?
  notes            String?
  tags             String[]
  splitItems       SplitItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  category   Category? @relation(fields: [categoryId], references: [id])
  account    Account?  @relation("FromAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount  Account?  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([kind])
  @@index([categoryId])
  @@index([accountId])
  @@index([date, kind])
}

model Debt {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  type           DebtType
  currentBalance Float
  originalAmount Float?
  apr            Float?
  minPayment     Float?
  dueDay         Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  payments DebtPayment[]
}

model DebtPayment {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  debtId          String   @db.ObjectId
  date            DateTime
  amount          Float
  fromAccountId   String   @db.ObjectId
  transactionId   String?  @db.ObjectId
  notes           String?
  createdAt       DateTime @default(now())

  debt        Debt    @relation(fields: [debtId], references: [id], onDelete: Cascade)
  fromAccount Account @relation(fields: [fromAccountId], references: [id])

  @@index([date])
  @@index([debtId])
}

model InvestmentHolding {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  accountId    String   @db.ObjectId
  symbol       String
  name         String
  quantity     Float
  avgCostBasis Float
  lastPrice    Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions InvestmentTransaction[]

  @@index([accountId])
  @@index([symbol])
}

model InvestmentTransaction {
  id        String                     @id @default(auto()) @map("_id") @db.ObjectId
  holdingId String                     @db.ObjectId
  accountId String                     @db.ObjectId
  date      DateTime
  type      InvestmentTransactionType
  quantity  Float
  price     Float
  amount    Float
  fees      Float                      @default(0)
  notes     String?
  createdAt DateTime                   @default(now())

  holding InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  account Account           @relation(fields: [accountId], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([holdingId])
}

model Goal {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  targetAmount Float
  dueDate      DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contributions GoalContribution[]
}

model GoalContribution {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  goalId        String   @db.ObjectId
  date          DateTime
  amount        Float
  fromAccountId String   @db.ObjectId
  notes         String?
  createdAt     DateTime @default(now())

  goal        Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  fromAccount Account @relation(fields: [fromAccountId], references: [id])

  @@index([date])
  @@index([goalId])
}

model Budget {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  month      DateTime
  categoryId String   @db.ObjectId
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([month, categoryId])
  @@index([month])
}
