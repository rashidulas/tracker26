# MongoDB Connection String
# Replace <user>, <pass>, <cluster>, and <db> with your actual values
DATABASE_URL="mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority"

# Example for local MongoDB:
# DATABASE_URL="mongodb://localhost:27017/tracker26"

# Login (required). Generate both values with: npm run auth:hash
# AUTH_PASSWORD_HASH is a bcrypt hash of your password, base64-encoded (a
# plain "$2b$..." hash would be mangled by .env "$" expansion).
# AUTH_SECRET signs the session cookie: at least 32 random characters.
# Without them a production build refuses to serve (503, "Login is not
# configured"); `npm run dev` stays open and shows a warning banner.
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# OpenAI API Key (assistant, receipt scanning and the AI helpers by default,
# and voice transcription)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Chat assistant model. Provider: openai (default), anthropic or google.
# The model must support tool calling and image input. Leave ASSISTANT_MODEL
# empty for the provider's default (openai: gpt-6.2-sol).
ASSISTANT_PROVIDER="openai"
ASSISTANT_MODEL=""
# Receipt scanning (the Scan button and receipts sent in chat) uses this same
# provider and model, so it must accept image input.
#
# Optional: a cheaper, faster model id (same provider) for the small one-shot
# helpers: quick-add text, category suggestions and search filters. Empty =
# use ASSISTANT_MODEL. Every helper falls back to the manual flow when no key
# is set or the model is slow.
ASSISTANT_FAST_MODEL=""
# Only needed for the matching provider (google also accepts GEMINI_API_KEY):
# ANTHROPIC_API_KEY="..."
# GOOGLE_GENERATIVE_AI_API_KEY="..."

# Signs the assistant's "approve this expense?" requests so a client cannot
# forge an approval. Any long random string, e.g. `openssl rand -base64 32`.
# If unset, a per-process secret is used and pending approvals stop working
# after a server restart.
ASSISTANT_APPROVAL_SECRET=""

# Your timezone (IANA name). Decides what "today" is for forms, the dashboard
# and the assistant. Read at build time, so rebuild after changing it.
# Defaults to America/New_York.
APP_TIMEZONE="America/New_York"

# Secret for the cron routes: the daily reminder run (/api/reminders/run,
# scheduled in vercel.json), the recurring due check (/api/recurring/run)
# and the daily insights check (/api/insights/run).
# Send it as "Authorization: Bearer <CRON_SECRET>" (Vercel Cron does this).
# The app also runs both checks whenever it is opened, so this is optional.
CRON_SECRET=""

# Reminder notifications (Web Push). Generate the pair with:
#   npx web-push generate-vapid-keys
# Without them reminders still show in the app; only notifications are off.
# VAPID_SUBJECT is a contact for the push services: "mailto:you@example.com"
# or the app's https address (the default on Vercel).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
