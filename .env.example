# MongoDB Connection String
# Replace <user>, <pass>, <cluster>, and <db> with your actual values
DATABASE_URL="mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority"

# Example for local MongoDB:
# DATABASE_URL="mongodb://localhost:27017/tracker26"

# Google Gemini API Key (for AI receipt scanning on Expenses page)
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (dashboard voice/text/receipt assistant)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Mobile API token (required for the iOS app — /api/v1/*)
# Use a long random string, e.g. generate one with: openssl rand -hex 32
# The iOS app sends it as "Authorization: Bearer <token>". Leave unset to disable the mobile API.
MOBILE_API_TOKEN="replace-with-a-long-random-string"
