# MongoDB Connection String
# Replace <user>, <pass>, <cluster>, and <db> with your actual values
DATABASE_URL="mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority"

# Example for local MongoDB:
# DATABASE_URL="mongodb://localhost:27017/tracker26"

# Google Gemini API Key (for AI receipt scanning on Expenses page)
# Get your free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# OpenAI API Key (chat assistant by default, and voice transcription)
# https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"

# Chat assistant model. Provider: openai (default), anthropic or google.
# The model must support tool calling and image input. Leave ASSISTANT_MODEL
# empty for the provider's default (openai: gpt-6.2-sol).
ASSISTANT_PROVIDER="openai"
ASSISTANT_MODEL=""
# Only needed for the matching provider (google also accepts GEMINI_API_KEY):
# ANTHROPIC_API_KEY="..."
# GOOGLE_GENERATIVE_AI_API_KEY="..."

# Signs the assistant's "approve this expense?" requests so a client cannot
# forge an approval. Any long random string, e.g. `openssl rand -base64 32`.
# If unset, a per-process secret is used and pending approvals stop working
# after a server restart.
ASSISTANT_APPROVAL_SECRET=""

# Your timezone (IANA name). Decides what "today" is for forms, the dashboard
# and the assistant. Read at build time, so rebuild after changing it.
# Defaults to America/New_York.
APP_TIMEZONE="America/New_York"
